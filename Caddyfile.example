# Beispiel-Caddyfile für den regoro-edit Inline-Editor.
#
# Aufgabe des Proxys:
#   - statische Site direkt ausliefern (schnell, billig, der Bun-Prozess ist
#     dafür NICHT im Pfad),
#   - /edit* an den Bun-Editor-Host (localhost:8788) weiterreichen (Auth dort),
#   - TLS automatisch (Let's-Encrypt / ACME) — das Auth-Cookie ist `Secure`,
#     setzt also HTTPS voraus,
#   - .regoro/ und alle Dotfiles HART blocken (404) — die Auth-Datei darf
#     niemals ausgeliefert werden,
#   - nur bekannte Dateitypen ausliefern (Allowlist, siehe unten).
#
# Anpassen: Domain, root-Pfad zur Site, ggf. Port.
#
# Das hier ist der EINZELBETRIEB: ein Prozess, eine Website. Für den
# Sammelbetrieb (ein Prozess, alle Kundenwebsites, Zuordnung über den
# Host-Header) siehe Caddyfile.multi.example.

example.com {
    encode gzip

    # --- Harte Block-Regel: Auth-Datei + Dotfiles nie ausliefern ---------------
    # Greift VOR allem anderen. Jedes Pfad-SEGMENT, das mit "." beginnt — also
    # /.regoro/auth.json ebenso wie /assets/.private.html oder /a/.git/config.
    # Muss regexp sein: ein `path /.*`-Matcher deckt nur führende Punkte, und
    # eine verschachtelte Dot-Datei mit erlaubter Endung käme sonst durch die
    # Asset-Allowlist unten hindurch. Spiegelt hasDotSegment() in host.ts.
    @hidden path_regexp (^|/)\.
    handle @hidden {
        respond 404
    }

    # --- Editor-Routen an den Bun-Host (Auth + Sessions laufen dort) -----------
    # Muss isEditorPath() in host.ts spiegeln. `/edit*` allein reicht NICHT:
    #   - es verfehlt die Suffix-Routen `/impressum.html/edit` (Editor pro Seite),
    #   - und es fängt zugleich öffentliche Seiten wie `/edit-preise.html` ein.
    #
    # HIER KEINE CSP: `connect-src 'none'` blockierte jedes fetch des Overlays.
    # Der Editor wäre stumm kaputt — Knöpfe reagieren, nichts wird gespeichert,
    # keine Fehlermeldung.
    @editor path /edit /edit/* /edit-assets/* */edit
    handle @editor {
        reverse_proxy localhost:8788 {
            # Der Agentenlauf meldet sich über Server-Sent Events; diese Zeile
            # schaltet jede Pufferung des Antwortkörpers ab.
            #
            # Sie ist NICHT der Grund, warum die Seitenleiste sofort aufgeht.
            # Gemessen (caddy 2.11.4, Upstream schweigt 4 s): Caddy gibt die
            # Antwort-HEADER erst mit dem ersten Körper-Byte heraus — 4,00 s,
            # mit dieser Zeile wie ohne. Dagegen hilft kein Proxy-Schalter.
            # Der Editor schickt deshalb beim Verbinden sofort einen
            # SSE-Kommentar (": verbunden\n", ohne Leerzeile — ein
            # vollständiger Rahmen erzeugte einen Phantom-Rahmen im Client);
            # damit sind es 0,002 s.
            # Wer hier eine Verzögerung sucht, sucht an der falschen Stelle.
            flush_interval -1
        }
    }

    # --- Statische Site: NUR erlaubte Dateitypen -------------------------------
    # Positive Allowlist, spiegelt ASSET_TYPES in src/sites.ts (+ .html für Seiten).
    # Grund: Ein Site-Ordner enthält oft mehr als die Website — Build-Artefakte
    # (design.json, images.json), Backups (dump.sql), Notizen (README.md). Der
    # Bun-Host liefert die dank Extension-Allowlist nie aus; ein blankes
    # `file_server` hier schon. Ohne diese Regel divergieren die beiden Pfade,
    # und der Proxy wird zum Leck. Kein .svg (script-fähig → Stored-XSS).
    #
    # `*.html` ist hier BEWUSST breiter als die pageWhitelist des Bun-Hosts: die
    # bestimmt, welche Seiten EDITIERBAR sind (top-level, [a-z0-9-]+.html), nicht
    # welche öffentlich sind. Caddy ist der Prod-Auslieferer und muss auch
    # Unterordner-Seiten bedienen (siehe README). Wer nur bestimmte Seiten
    # veröffentlichen will, ersetzt `*.html` durch eine explizite Liste:
    #     @allowed path / /index.html /impressum.html /datenschutz.html *.css …
    # Und legt Entwürfe/Backups grundsätzlich nicht in den Webroot.
    @allowed path / */ *.html *.css *.js *.png *.jpg *.jpeg *.webp *.gif *.ico *.woff *.woff2 *.txt *.xml
    handle @allowed {
        # WICHTIG: derselbe Ordner, den `regoro-edit <dir>` bearbeitet, sonst
        # divergieren öffentliche Seite und Editier-Ziel.
        root * /srv/site

        # --- Content-Security-Policy: die dritte Grenze des KI-Editors --------
        # Sie steht HIER und nicht im HTML: Der Agent schreibt HTML, also wäre
        # eine Grenze im HTML eine, die er umschreiben kann. Dieser Block liegt
        # außerhalb seiner Reichweite.
        #
        # `connect-src 'none'` ist der Kern — kein fetch, kein XHR, kein
        # sendBeacon, kein WebSocket. Mit `img-src 'self' data:` (kein
        # Bild-Beacon) und `form-action 'self'` sind die stillen Abflüsse zu.
        #
        # `'unsafe-inline'` bei script-src ist ABSICHT: Die Fabrik liefert
        # Inline-Skripte aus (Kopfzeile gegen Layout-Sprung, JSON-LD). An echten
        # Kundenseiten dreimal nachgezählt — 8, 12, 13 Blöcke, je nach Seite,
        # aber KEIN EINZIGER mit `src`. Ohne das wäre jeder davon tot und
        # bestehende Kundenseiten kaputt.
        #
        # Muss mit cspWert() in src/service.ts übereinstimmen (per Test
        # festgenagelt). Hat eine Website Integrationen mit Browser-Herkünften
        # (`regoro integration … --browser-herkunft …`), gehören die zusätzlich
        # in script-src UND connect-src — `regoro service` erzeugt die Zeile
        # dann fertig. `'none'` neben einer Quelle wäre ungültig, Browser
        # verwürfen die ganze Direktive und ließen anschließend alles durch.
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"

        # Spiegelt X-Content-Type-Options aus SECURITY_HEADERS (src/host.ts) in
        # den statischen Zweig: In Produktion liefert Caddy die Website direkt
        # aus, der Bun-Host ist dafür gar nicht im Pfad. Wogegen: ein
        # Polyglot-Asset mit gültiger Bild-Signatur und eingebettetem HTML/JS.
        #
        # Die beiden ANDEREN Header aus SECURITY_HEADERS gehören hier NICHT her
        # — sie gelten dem Editor und wären hier ein Schaden:
        # `X-Robots-Tag: noindex` nähme die Website aus dem Index,
        # `Cache-Control: no-store` verböte jedes Zwischenspeichern.
        header X-Content-Type-Options "nosniff"

        file_server
    }

    # --- Alles andere: existiert für die Öffentlichkeit nicht ------------------
    handle {
        respond 404
    }
}
